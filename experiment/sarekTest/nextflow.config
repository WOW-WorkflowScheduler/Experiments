params {
    
    // Parameters for full-size test
    input                     = '/input/input/samplesheet_test.csv'

    intervals                 = '/input/input/genome.interval_list'

    bcftools_annotations      = '/input/input/test2.vcf.gz'
    bcftools_annotations_tbi  = '/input/input/test2.vcf.gz.tbi'
    bcftools_header_lines     = '/input/sarekTest/tests/config/bcfann_test_header.txt'

    dbsnp                     = '/input/input/dbsnp_146.hg38.vcf.gz'
    dbsnp_tbi                 = '/input/input/dbsnp_146.hg38.vcf.gz.tbi'
    dict                      = '/input/input/genome.dict'
    fasta                     = '/input/input/genome.fasta'
    fasta_fai                 = '/input/input/genome.fasta.fai'
    germline_resource         = '/input/input/gnomAD.r2.1.1.vcf.gz'
    germline_resource_tbi     = '/input/input/gnomAD.r2.1.1.vcf.gz.tbi'
    known_indels              = '/input/input/mills_and_1000G.indels.vcf.gz'
    known_indels_tbi          = '/input/input/mills_and_1000G.indels.vcf.gz.tbi'
    ngscheckmate_bed          = '/input/input/SNP_GRCh38_hg38_wChr.bed'
    sentieon_dnascope_model   = '/input/input/SentieonDNAscopeModel1.1.model'

    max_memory                = '60.GB'
    max_cpus                  = 30
    outdir                    = "/input/data/out/"
}


executor {
    queueSize = 5000
}