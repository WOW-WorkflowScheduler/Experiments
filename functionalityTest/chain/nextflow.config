params {
    minSizeGB = 0.1
    maxSizeGB = 0.2
    numberOfTasks = 20
}

process {
    
    container = 'fabianlehmann/test1:fio'

    withName: 'writeLargeFile' {
        cpus = 10
        memory = '10240.MB'
    }
    withName: 'revertFile' {
        cpus = 10
        memory = '10240.MB'
    }
    withName: 'combineFiles' {
        cpus = 10
        memory = '20240.MB'
    }
    
}
